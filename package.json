  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pkg": "tsup && tsup --config tsup.deep.config.ts && tsx scripts/fix-deep-imports.ts && pnpm build:tokens",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "storybook": "tsx scripts/prepare-storybook.ts && storybook dev -p 6006",
    "build:storybook": "tsx scripts/prepare-storybook.ts && storybook build && tsx scripts/check-storybook.ts",
    "build:tokens": "tsx scripts/build-tokens.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "test:browser": "playwright test",
    "check:package": "tsx scripts/check-package.ts && tsx scripts/check-consumers.ts",
    "check:types": "tsc --noEmit",
    "check:package:boundary": "tsx scripts/check-package.ts",
    "check:consumers": "tsx scripts/check-consumers.ts",
    "preview:storybook": "tsx scripts/serve-storybook.ts"
  },
  "peerDependencies": {
    "next": "^15 || ^16",
    "next-intl": "^4",
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@axe-core/react": "^4.11.1",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.1",
    "@playwright/test": "^1.63.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/nextjs-vite": "10.4.6",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "eslint-config-prettier": "^10.1.8",
    "gray-matter": "^4.0.3",
    "next": "16.1.7",
    "next-intl": "^4.8.3",
    "pretendard": "^1.3.9",
    "prettier": "^3.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "reading-time": "^1.5.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "shadcn": "^3.8.5",
    "storybook": "10.4.6",
    "style-dictionary": "^4.4.0",
    "tailwindcss": "^4",
    "three": "^0.183.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist/",
    "src/styles/",
    "DESIGN.md",
    "docs/design/v2-migration.md",
    "docs/package-release.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses/",
    "docs/components/",
    "docs/design/public-ui-support.md",
    "docs/design/public-ui-stage3-verification.md"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "style-dictionary",
      "@bundled-es-modules/glob"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naeil-dev/naeil-ui.git"
  },
  "description": "React UI components, semantic design tokens and shared styles; optional Next.js brand compatibility components.",
  "keywords": [
    "design-system",
    "react",
    "components",
    "tailwindcss",
    "radix-ui",
    "next.js",
    "i18n"
  ],
  "homepage": "https://github.com/naeil-dev/naeil-ui#readme",
  "bugs": {
    "url": "https://github.com/naeil-dev/naeil-ui/issues"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "next-intl": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.30.3"
}
