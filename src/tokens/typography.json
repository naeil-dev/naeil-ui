{
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Pretendard Variable",
          "Pretendard",
          "Noto Sans JP",
          "-apple-system",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "Geist Mono",
          "ui-monospace",
          "monospace"
        ]
      },
      "japanese": {
        "$type": "fontFamily",
        "$value": [
          "Pretendard Latin",
          "Noto Sans JP",
          "Pretendard Variable",
          "Pretendard",
          "Noto Sans JP",
          "-apple-system",
          "system-ui",
          "sans-serif"
        ]
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "0.8125rem"
      },
      "sm": {
        "$type": "dimension",
        "$value": "0.875rem"
      },
      "base": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "lg": {
        "$type": "dimension",
        "$value": "1.125rem"
      },
      "xl": {
        "$type": "dimension",
        "$value": "1.25rem"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "1.5rem"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "2rem"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "2.25rem"
      }
    },
    "weight": {
      "normal": {
        "$type": "number",
        "$value": 400
      },
      "medium": {
        "$type": "number",
        "$value": 500
      },
      "bold": {
        "$type": "number",
        "$value": 700
      },
      "semibold": {
        "$type": "number",
        "$value": 600
      }
    },
    "lineHeight": {
      "tight": {
        "$type": "number",
        "$value": 1.25
      },
      "normal": {
        "$type": "number",
        "$value": 1.5625
      },
      "relaxed": {
        "$type": "number",
        "$value": 1.875
      }
    },
    "sizeLineHeight": {
      "xs": {
        "$type": "dimension",
        "$value": "1.25rem"
      },
      "sm": {
        "$type": "dimension",
        "$value": "1.375rem"
      },
      "base": {
        "$type": "dimension",
        "$value": "1.5625rem"
      },
      "xl": {
        "$type": "dimension",
        "$value": "1.8125rem"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "2.625rem"
      }
    },
    "chrome": {
      "lineHeight": {
        "sheet": {
          "$type": "dimension",
          "$value": "28px",
          "$description": "Preserves the canonical chrome 20/28 sheet heading, distinct from the 20/29 section title."
        },
        "menu": {
          "$type": "dimension",
          "$value": "24px",
          "$description": "Preserves the canonical chrome 16/24 menu/control rows, distinct from the 16/25 body."
        },
        "account": {
          "$type": "dimension",
          "$value": "20px",
          "$description": "Preserves 14/20 account metadata; footer/supporting copy uses font.lineHeight.normal (14/21.875)."
        }
      }
    }
  }
}
