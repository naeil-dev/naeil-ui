{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true
  },
  "exclude": [
    "node_modules",
    ".next",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/*.stories.*"
  ]
}
